# Application
APP_NAME=SchemeSathi
APP_VERSION=2.0.0
DEBUG=true

# API
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=mysql+pymysql://root:the821052005@localhost:3306/schemesathi

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_SECONDS=30

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
# Full HTTPS data-plane host for the selected Pinecone index.
PINECONE_INDEX_HOST=
RAG_KEYWORD_LIMIT=12
RAG_SEMANTIC_LIMIT=12
RAG_MIN_KEYWORD_SCORE=0.1
RAG_MIN_SEMANTIC_SCORE=0.35

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET_KEY=CHANGE_THIS_BEFORE_USE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Gnani voice
GNANI_API_KEY_ID=
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v2.5
GNANI_REQUEST_TIMEOUT=60