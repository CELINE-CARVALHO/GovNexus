# Application
APP_NAME=GovNexus
APP_VERSION=2.0.0
DEBUG=true
API_V1_PREFIX=/api/v1

# MySQL
MYSQL_USER=schemesathi
MYSQL_PASSWORD=CHANGE_THIS_TO_YOUR_LOCAL_MYSQL_PASSWORD
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=schemesathi

# Redis (configured for deployments that enable queue workers)
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Source administration (server-side only; never put this value in frontend code)
SOURCE_ADMIN_API_KEY=

# Groq is the primary assistant. Gemini is used only if Groq is
# unconfigured or the Groq request fails. Never put these keys in frontend code.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=30

# Gemini (fallback generation, plus embeddings)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_SECONDS=30

# Pinecone (optional; keyword retrieval remains available when unconfigured)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_INDEX_HOST=
RAG_KEYWORD_LIMIT=12
RAG_SEMANTIC_LIMIT=12
RAG_MIN_KEYWORD_SCORE=0.1
RAG_MIN_SEMANTIC_SCORE=0.35

# Gnani voice (optional; required only for live transcription and synthesis)
GNANI_API_KEY_ID=
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v2.5
GNANI_REQUEST_TIMEOUT=60
